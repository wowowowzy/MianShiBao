.page {
  height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.summary {
  display: flex;
  align-items: center;
  gap: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.score-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 14rpx solid currentColor;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
}
.score-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
}
.score-total {
  font-size: 26rpx;
  font-weight: 400;
}
.score-pct {
  font-size: 26rpx;
  margin-top: 4rpx;
}
.summary-side {
  flex: 1;
}
.summary-title {
  font-size: 40rpx;
  font-weight: 700;
}
.summary-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #86868b;
  line-height: 1.6;
}

.item-card {
  padding: 0;
  overflow: hidden;
}
.item-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 28rpx 30rpx;
}
.item-index {
  font-weight: 700;
  color: #0071e3;
}
.item-stem {
  flex: 1;
  font-size: 28rpx;
}
.item-score {
  font-size: 28rpx;
  font-weight: 700;
  flex: none;
}
.item-score.full { color: #67c23a; }
.item-score.mid { color: #e6a23c; }
.item-score.zero { color: #f56c6c; }
.item-arrow {
  color: #a1a1a6;
  font-size: 24rpx;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}
.item-arrow.open {
  transform: rotate(180deg);
}

.item-body {
  padding: 8rpx 30rpx 36rpx;
  border-top: 2rpx solid #f2f2f4;
}
.item-tags {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0 8rpx;
}
.block-title {
  margin: 24rpx 0 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6e6e73;
}
.block-content {
  padding: 20rpx 24rpx;
  background: #f5f5f7;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.block-content.explain {
  background: #f0f9eb;
}
.point-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  flex-wrap: wrap;
}
.point-mark {
  font-weight: 700;
}
.point-mark.hit { color: #67c23a; }
.point-mark.miss { color: #f56c6c; }
.point-text { flex: 1; }
.point-score { font-weight: 700; color: #6e6e73; }
.point-evidence {
  width: 100%;
  font-size: 22rpx;
  color: #a1a1a6;
  padding-left: 30rpx;
}
.restart-btn {
  margin-top: 30rpx;
}