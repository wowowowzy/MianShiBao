.page {
  height: 100vh;
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.welcome {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}
.welcome-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
}
.welcome-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #86868b;
}
.home-btn {
  margin-top: 24rpx;
  width: 200rpx;
}

.stats {
  display: flex;
  gap: 16rpx;
}
.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #0a84ff, #0071e3);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.stat-label {
  font-size: 24rpx;
  color: #6e6e73;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin: 28rpx 0 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #6e6e73;
  border-radius: 16rpx;
}
.tab-item.on {
  background: #0071e3;
  color: #ffffff;
  font-weight: 600;
}

.rec-card,
.sub-card,
.paper-card {
  padding: 26rpx 28rpx;
}
.rec-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.rec-skill {
  margin-top: 14rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.rec-skill.processing { color: #a1a1a6; }
.rec-skill.failed { color: #f56c6c; }
.rec-exp {
  font-size: 22rpx;
  color: #a1a1a6;
}
.rec-meta {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rec-time {
  font-size: 24rpx;
  color: #a1a1a6;
}
.rec-actions,
.paper-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.op-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f2f4;
  color: #6e6e73;
  font-size: 24rpx;
}
.op-btn.strong {
  background: rgba(0, 113, 227, 0.1);
  color: #0071e3;
}
.op-btn.danger {
  background: #fef0f0;
  color: #f56c6c;
}

.sub-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
}
.sub-pct {
  font-size: 36rpx;
  font-weight: 700;
  width: 120rpx;
}
.sub-pct.good { color: #67c23a; }
.sub-pct.mid { color: #e6a23c; }
.sub-pct.low { color: #f56c6c; }
.sub-score {
  flex: 1;
  font-size: 28rpx;
}
.sub-action {
  margin-left: auto;
}

.paper-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.paper-count {
  font-size: 30rpx;
  flex: 1;
}
.paper-actions {
  width: 100%;
  margin-top: 14rpx;
}

/* 简历详情 */
.rv-meta {
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.rv-row {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
}
.rv-label {
  color: #6e6e73;
  width: 140rpx;
  flex: none;
}
.rv-section {
  font-size: 28rpx;
  font-weight: 700;
  color: #6e6e73;
  margin: 24rpx 0 14rpx;
}
.rv-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rv-proj {
  margin-bottom: 20rpx;
}
.rv-proj-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.p-name {
  font-size: 28rpx;
  font-weight: 600;
}
.p-role {
  font-size: 24rpx;
  color: #a1a1a6;
}
.p-tech {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.rv-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6e6e73;
  line-height: 1.7;
}

/* 学习路线 */
.plan-alert {
  padding: 20rpx 24rpx;
  background: #f0f5ff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #2b5cb8;
  margin-bottom: 16rpx;
}
.plan-duration {
  font-size: 28rpx;
  font-weight: 600;
  color: #6e6e73;
  margin-bottom: 12rpx;
}
.phase {
  padding: 24rpx;
  background: #f5f5f7;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}
.phase-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.phase-idx {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #0a84ff, #0071e3);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.phase-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}
.phase-days {
  font-size: 22rpx;
  color: #a1a1a6;
}
.phase-block {
  margin-top: 12rpx;
}
.phase-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6e6e73;
  margin-bottom: 6rpx;
}
.phase-li {
  font-size: 26rpx;
  color: #1d1d1f;
  line-height: 1.7;
  padding-left: 20rpx;
  position: relative;
}
.phase-li::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #0071e3;
}