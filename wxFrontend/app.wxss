/**
 * 全局样式：设计基调与 web 端保持一致（主色 #0071e3 系）。
 */
page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ---- 卡片 ---- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.btn-primary {
  background: linear-gradient(180deg, #0a84ff, #0071e3);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(0, 113, 227, 0.35);
}
.btn-primary.bigtech {
  background: linear-gradient(180deg, #ff8a3d, #ff5a1f);
  box-shadow: 0 10rpx 24rpx rgba(255, 90, 31, 0.35);
}
.btn-ghost {
  background: #ffffff;
  color: #0071e3;
  border: 2rpx solid #d8d8dc;
}
.btn-mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.btn-soft {
  background: rgba(0, 113, 227, 0.1);
  color: #0071e3;
}
.btn-danger-plain {
  background: #ffffff;
  color: #f56c6c;
  border: 2rpx solid #fbc4c4;
}
.btn[disabled] {
  opacity: 0.5;
}

/* ---- 标签 ---- */
.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.tag-basic { background: #f0f9eb; color: #67c23a; }
.tag-inter { background: #fdf6ec; color: #e6a23c; }
.tag-adv { background: #fef0f0; color: #f56c6c; }
.tag-info { background: #f2f2f4; color: #6e6e73; }
.tag-warn { background: #fdf6ec; color: #b88230; }
.tag-danger { background: #fef0f0; color: #f56c6c; }

/* ---- 文本 ---- */
.t-title { font-size: 40rpx; font-weight: 700; letter-spacing: -0.02em; }
.t-sub { font-size: 26rpx; color: #86868b; }
.t-muted { color: #86868b; }
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 空态 / 加载 ---- */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #a1a1a6;
  font-size: 26rpx;
}

/* ---- 遮罩弹层（学习路线 / 简历详情 / 隐私说明共用） ---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
  display: flex;
  align-items: flex-end;
}
.mask-card {
  width: 100%;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.mask-scroll {
  flex: 1;
  min-height: 0;
  max-height: 70vh;
}
.mask-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}
.mask-close {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f2f4;
  color: #6e6e73;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  z-index: 5;
}
.mask-body {
  flex: 1;
  min-height: 0;
}
