# 复制为 .env 后填写真实密钥（.env 不入库）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ZHIPU_API_KEY=xxx
ZHIPU_OCR_MODEL=glm-ocr
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 微信小程序静默登录（AppID 与 secret 均在微信公众平台「开发-开发管理-开发设置」获取）
WECHAT_MINIAPP_APPID=<你的小程序 AppID>
WECHAT_MINIAPP_SECRET=xxx

# JWT 签名密钥（HS256，至少 32 字节；用于登录令牌签发/校验）
# 生成示例：openssl rand -base64 48
JWT_SECRET=